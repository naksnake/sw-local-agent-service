{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slas.local/schemas/factory-plan.schema.json",
  "title": "SW Local Agent Service — Factory plan",
  "description": "A compiled Factory test loop: deterministic steps the factory executor performs on a station through the station runner (CLAUDE.md §10.3). PASS needs 3 of 3 voters.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "required": [
    "id",
    "job_id",
    "summary",
    "steps",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "primitive": {
          "enum": [
            "lease_station",
            "station_command",
            "skill",
            "wait_for_screen",
            "read_result",
            "read_sensors",
            "check_event_log",
            "verdict",
            "backup_station",
            "release_station",
            "station_config_change"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "args": {
          "type": "object"
        },
        "risk": {
          "enum": [
            "safe",
            "caution",
            "destructive"
          ]
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "n",
        "primitive",
        "title",
        "args",
        "risk"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "type": "object",
          "description": "Take the exclusive lease on the station and bind the unit's serial number.",
          "properties": {
            "primitive": {
              "const": "lease_station"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "unit_sn": {
                  "type": "string",
                  "minLength": 1
                },
                "mes_ticket_no": {
                  "type": "string"
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station",
                "unit_sn"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Run one allowlisted program on the station (fixture power, tool control).",
          "properties": {
            "primitive": {
              "const": "station_command"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "expect_exit": {
                  "type": "integer"
                },
                "timeout_s": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station",
                "command"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Run an imported skill's GUI steps on the station through the runner; every step is screenshot before and after.",
          "properties": {
            "primitive": {
              "const": "skill"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "skill_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "inputs": {
                  "type": "object"
                },
                "secret_refs": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^(env|vault|file):"
                  },
                  "description": "Skill input → credential reference; the value is resolved at dispatch."
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station",
                "skill_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Wait until a text appears on the station's screen.",
          "properties": {
            "primitive": {
              "const": "wait_for_screen"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_s": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Read the vendor test result as JSON from the station.",
          "properties": {
            "primitive": {
              "const": "read_result"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station",
                "command"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Read the unit's sensors as JSON and compare them with the limits.",
          "properties": {
            "primitive": {
              "const": "read_sensors"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station",
                "command",
                "limits"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Dump the unit's event log; it must be empty.",
          "properties": {
            "primitive": {
              "const": "check_event_log"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station",
                "command"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Decide: the deterministic gate (result, sensors, event log), then 3 of 3 voters for PASS; anything else holds the station for the line lead.",
          "properties": {
            "primitive": {
              "const": "verdict"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Collect the station's config, recent logs and application versions into Backups/stations/<station>/<ticket>.",
          "properties": {
            "primitive": {
              "const": "backup_station"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Release the station lease.",
          "properties": {
            "primitive": {
              "const": "release_station"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        },
        {
          "type": "object",
          "description": "Change a station setting. Destructive: needs a per-run approval.",
          "properties": {
            "primitive": {
              "const": "station_config_change"
            },
            "args": {
              "type": "object",
              "properties": {
                "station": {
                  "type": "string",
                  "minLength": 1
                },
                "setting": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                },
                "loop_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "loop_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "station",
                "setting",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "args"
          ]
        }
      ]
    }
  }
}
