# SW Local Agent Service — configuration template (CLAUDE.md §3, §12).
#
# install.sh copies this file to .env and fills in the generated values (Phase 1).
# One line of explanation per setting. Model and user changes never need an edit here
# (INV-9); the settings below are host-level and read once at start.

# Deployment profile: quickstart (default) or prod. See CLAUDE.md §3.
SLAS_PROFILE=quickstart

# Where all data lives: projects, runs, tickets, models, knowledge, backups (CLAUDE.md §4.4).
SLAS_DATA_ROOT=/AI/Agent

# Port the web interface listens on, with TLS.
SLAS_HTTPS_PORT=443

# TLS certificate source: self-signed (quickstart default) or provided
# (cert.pem and key.pem under ${SLAS_DATA_ROOT}/tls/).
SLAS_TLS_MODE=self-signed

# Generated by install.sh. Derives the key that encrypts stored credentials such as Git
# remotes in quickstart (CLAUDE.md §5.7). The prod profile keeps secrets in Vault instead.
SLAS_SECRET_KEY=

# Second language for SOPs, reports and ticket exports: zh-Hant (default) or zh-Hans (INV-13).
SLAS_SOP_CHINESE=zh-Hant

# Internal services. Passwords are generated by install.sh and never leave the backend network.
POSTGRES_DB=slas
POSTGRES_USER=slas
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=slas
MINIO_ROOT_PASSWORD=

# GPUs visible to the inference containers, as a comma-separated list of ids. Empty = all.
SLAS_GPU_IDS=

# Air-gap flags applied to every container (INV-1, INV-2). Do not change.
DO_NOT_TRACK=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
VLLM_NO_USAGE_STATS=1
