# SW Local Agent Service: environment file (CLAUDE.md §3, §12).
# install.sh generates the real .env in Phase 1; this example lists every variable.
# Secrets are left empty here on purpose. Never commit a real .env.

# Deployment profile: quickstart (default) or prod.
SLAS_PROFILE=quickstart

# Where platform data lives (CLAUDE.md §4.4).
SLAS_DATA_ROOT=/AI/Agent

# Port the edge proxy publishes the web interface on.
SLAS_EDGE_PORT=443

# Generated by install.sh: key material for the encrypted-by-reference credential store (§5.7).
SLAS_SECRET_KEY=

# Generated by install.sh: service passwords.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Logging (structlog JSON, CLAUDE.md §11).
SLAS_LOG_LEVEL=info
