# SW Local Agent Service — configuration template (CLAUDE.md §3, §12).
#
# install.sh copies this file to .env and fills in the generated values (Phase 1).
# One line of explanation per setting. Model and user changes never need an edit here
# (INV-9); the settings below are host-level and read once at start.

# Deployment profile: quickstart (default) or prod. See CLAUDE.md §3.
SLAS_PROFILE=quickstart

# Where all data lives: projects, runs, tickets, models, knowledge, backups (CLAUDE.md §4.4).
SLAS_DATA_ROOT=/AI/Agent

# Port the web interface listens on, with TLS.
SLAS_HTTPS_PORT=443

# TLS certificate source: self-signed (quickstart default; the edge's own CA, its root at
# ${SLAS_DATA_ROOT}/tls/caddy/pki/authorities/local/root.crt) or provided (server.crt and
# server.key under ${SLAS_DATA_ROOT}/tls/).
SLAS_TLS_MODE=self-signed

# Container-runtime socket mounted into model-manager and sandbox-manager only (INV-4); empty
# means rootless Podman's /run/podman/podman.sock. install.sh writes /var/run/docker.sock here
# when there is no Podman socket and Docker's exists (ADR-0015), and says so.
SLAS_RUNTIME_SOCKET=

# Generated by install.sh. Derives the key that encrypts stored credentials such as Git
# remotes in quickstart (CLAUDE.md §5.7). The prod profile keeps secrets in Vault instead.
SLAS_SECRET_KEY=

# Second language for SOPs, reports and ticket exports: zh-Hant (default) or zh-Hans (INV-13).
SLAS_SOP_CHINESE=zh-Hant

# Internal services. Passwords are generated by install.sh and never leave the backend network.
POSTGRES_DB=slas
POSTGRES_USER=slas
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=slas
MINIO_ROOT_PASSWORD=

# GPUs visible to the inference containers, as a comma-separated list of ids. Empty = all.
SLAS_GPU_IDS=
# Memory per GPU in GiB the model manager places instances against (vram_gib in models.yaml);
# 270 leaves headroom on a 288 GB HGX B300 GPU (set 170 for a 192 GB part). An instance
# that does not fit is reported, never started.
SLAS_GPU_VRAM_GIB=270

# Lab VLAN for the validation executor (compose/macvlan.override.yml, CLAUDE.md §4.1 Zone B).
# The host NIC on the lab VLAN, the VLAN's subnet and gateway, and the executor's own address.
SLAS_LAB_IFACE=
SLAS_LAB_SUBNET=
SLAS_LAB_GATEWAY=
SLAS_LAB_EXECUTOR_IP=

# Target credentials are referenced from target records as env:NAME (quickstart) and read
# by the validation executor at dispatch; they never appear in a record, a log or a model
# context (INV-5). One line per target, for example LAB_GX8_01_BMC_PASSWORD= and
# LAB_GX8_01_SSH_KEY= (the private key, newlines as \n). The prod profile uses vault:PATH.

# Air-gap flags applied to every container (INV-1, INV-2). Do not change.
DO_NOT_TRACK=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
VLLM_NO_USAGE_STATS=1

# --- prod profile (ADR-0012) ---
# Written by install.sh --profile prod; every key can be changed here and applies on the next
# `docker compose up`. Secrets stay files under ${SLAS_DATA_ROOT}/secrets, never keys here.
# Registry inside the perimeter the prod images are pulled from (Harbor); images are verified
# with cosign against config/cosign.pub before they are pulled.
SLAS_REGISTRY=
# The release version the compose files reference for first-party images.
SLAS_VERSION=
# The host name browsers use; Keycloak and the OIDC redirect are bound to it.
SLAS_PUBLIC_HOST=
# Sign-in modes the page offers: builtin (quickstart) or builtin,oidc (prod).
SLAS_AUTH_MODES=builtin
# The agents and optional parts this installation starts (ADR-0017): coding, or any of
# coding,validation,factory,knowledge. Validation and Factory bring their executors and pages,
# knowledge the Qdrant and local-search containers; ./install.sh --agents writes the choice here.
SLAS_AGENTS=coding
# Keycloak realm the api trusts (prod).
SLAS_OIDC_ISSUER=
SLAS_OIDC_CLIENT_ID=slas-webui
# Code sandboxes: gvisor, or kata for a Kata micro-VM on Firecracker per sandbox (prod).
SLAS_SANDBOX_TIER=gvisor
# Backups: weekday (0 = Sunday) of the weekly full backup, hour (UTC) of the daily run,
# object-lock retention in days for backups (compliance) and run artifacts (governance).
SLAS_BACKUP_FULL_CRON=0
SLAS_BACKUP_DIFF_CRON=2
SLAS_BACKUP_RETENTION_DAYS=90
SLAS_ARTIFACT_RETENTION_DAYS=30
# Factory LAN for the factory executor (compose/macvlan-factory.override.yml, Zone B').
SLAS_FACTORY_IFACE=
SLAS_FACTORY_SUBNET=
SLAS_FACTORY_GATEWAY=
SLAS_FACTORY_EXECUTOR_IP=
