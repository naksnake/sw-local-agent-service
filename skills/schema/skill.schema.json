{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slas.local/schemas/skill.schema.json",
  "title": "SW Local Agent Service skill",
  "description": "A skill recipe: whitelisted steps only (CLAUDE.md §6). Generated by slas_skills.jsonschema.build_skill_schema(); do not edit by hand.",
  "type": "object",
  "properties": {
    "skill": {
      "$ref": "#/$defs/skill"
    }
  },
  "required": [
    "skill"
  ],
  "additionalProperties": false,
  "$defs": {
    "skill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string"
        },
        "agents": {
          "type": "array",
          "items": {
            "enum": [
              "coding",
              "validation",
              "factory"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requires": {
          "type": "array",
          "items": {
            "enum": [
              "files",
              "network",
              "redfish",
              "screen",
              "ssh"
            ]
          },
          "uniqueItems": true
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/input"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1,
          "maxItems": 200
        },
        "on_failure": {
          "oneOf": [
            {
              "enum": [
                "stop",
                "screenshot_and_stop",
                "continue"
              ]
            },
            {
              "type": "object",
              "properties": {
                "retry": {
                  "type": "object",
                  "properties": {
                    "max": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "delay_s": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 600
                    }
                  },
                  "required": [
                    "max"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "retry"
              ],
              "additionalProperties": false
            }
          ]
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from"
            ],
            "additionalProperties": false
          }
        },
        "sop_summary": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string"
            },
            "zh": {
              "type": "string"
            }
          },
          "required": [
            "en",
            "zh"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "agents",
        "steps"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "string",
            "int",
            "bool",
            "path",
            "target_ref",
            "secret"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "focus_window": {
              "type": "object",
              "description": "Bring a window to the front by title or class.",
              "properties": {
                "class": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "title"
                  ]
                },
                {
                  "required": [
                    "class"
                  ]
                }
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "focus_window"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "click": {
              "type": "object",
              "description": "Click a target found by text, image, accessible target or coordinates.",
              "properties": {
                "image": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "image"
                  ]
                },
                {
                  "required": [
                    "target"
                  ]
                },
                {
                  "required": [
                    "x",
                    "y"
                  ]
                }
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "click"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "double_click": {
              "type": "object",
              "description": "Double-click a target.",
              "properties": {
                "image": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "image"
                  ]
                },
                {
                  "required": [
                    "target"
                  ]
                },
                {
                  "required": [
                    "x",
                    "y"
                  ]
                }
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "double_click"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "right_click": {
              "type": "object",
              "description": "Right-click a target.",
              "properties": {
                "image": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "image"
                  ]
                },
                {
                  "required": [
                    "target"
                  ]
                },
                {
                  "required": [
                    "x",
                    "y"
                  ]
                }
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "right_click"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "object",
              "description": "Type text; may reference a {{ secret }} and is then never logged.",
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "object",
              "description": "Press a key or chord such as Enter, Tab or ctrl+s.",
              "properties": {
                "press": {
                  "type": "string"
                }
              },
              "required": [
                "press"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scroll": {
              "type": "object",
              "description": "Scroll in a direction by an amount.",
              "properties": {
                "amount": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "direction": {
                  "enum": [
                    "up",
                    "down",
                    "left",
                    "right"
                  ]
                }
              },
              "required": [
                "direction",
                "amount"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "scroll"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "wait_for": {
              "type": "object",
              "description": "Wait until a window, text or image appears.",
              "properties": {
                "image": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "timeout_s": {
                  "type": [
                    "integer",
                    "string"
                  ],
                  "minimum": 1
                },
                "window": {
                  "type": "string"
                }
              },
              "required": [],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "window"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "image"
                  ]
                }
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "wait_for"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "screenshot": {
              "type": "object",
              "description": "Take a named screenshot.",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "screenshot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "assert_visible": {
              "type": "object",
              "description": "Fail with a message unless text or an image is visible.",
              "properties": {
                "image": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "image"
                  ]
                }
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "assert_visible"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "object",
              "description": "Run an argv list in the sandbox or on the target; never a shell line.",
              "properties": {
                "capture": {
                  "type": [
                    "boolean",
                    "string"
                  ]
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "cwd": {
                  "type": "string"
                },
                "expect_exit": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "timeout_s": {
                  "type": [
                    "integer",
                    "string"
                  ],
                  "minimum": 1
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ssh": {
              "type": "object",
              "description": "Run an argv list on a target over SSH.",
              "properties": {
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "target": {
                  "type": "string"
                },
                "timeout_s": {
                  "type": [
                    "integer",
                    "string"
                  ],
                  "minimum": 1
                }
              },
              "required": [
                "target",
                "command"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "ssh"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "copy": {
              "type": "object",
              "description": "Copy a file within the workspace or over SSH.",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "copy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "redfish": {
              "type": "object",
              "description": "Read or control a BMC; power actions are destructive.",
              "properties": {
                "action": {
                  "enum": [
                    "force_off",
                    "get_inventory",
                    "get_power_state",
                    "get_sel",
                    "graceful_restart",
                    "power_off",
                    "power_on"
                  ]
                },
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "target",
                "action"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "redfish"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "sel_snapshot": {
              "type": "object",
              "description": "Save the BMC event log.",
              "properties": {
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "sel_snapshot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "inventory_snapshot": {
              "type": "object",
              "description": "Save the hardware inventory.",
              "properties": {
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "inventory_snapshot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "wait": {
              "type": "object",
              "description": "Pause for a number of seconds (at most 3600).",
              "properties": {
                "seconds": {
                  "type": [
                    "integer",
                    "number",
                    "string"
                  ],
                  "minimum": 0,
                  "maximum": 3600
                }
              },
              "required": [
                "seconds"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "wait"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "set": {
              "type": "object",
              "description": "Set a variable from a value or a previous step's output.",
              "properties": {
                "value": {
                  "type": "string"
                },
                "var": {
                  "type": "string"
                }
              },
              "required": [
                "var",
                "value"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "set"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "assert": {
              "type": "object",
              "description": "Fail with a message unless a condition holds.",
              "properties": {
                "condition": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "condition",
                "message"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "assert"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "if": {
              "type": "object",
              "description": "Run `then` steps when a condition holds, else `else` steps.",
              "properties": {
                "condition": {
                  "type": "string"
                },
                "else": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/step"
                  },
                  "minItems": 1
                },
                "then": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/step"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "condition",
                "then"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "if"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "foreach": {
              "type": "object",
              "description": "Run `then` steps once per item (at most 100 items).",
              "properties": {
                "as": {
                  "type": "string"
                },
                "items": {
                  "type": [
                    "array",
                    "string"
                  ],
                  "maxItems": 100
                },
                "then": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/step"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "items",
                "then"
              ],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "when": {
              "type": "string"
            }
          },
          "required": [
            "foreach"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
